# ==============================================================================
# Variables d'environnement — Ferme Familiale
# ==============================================================================
# Copier ce fichier en `.env` et adapter les valeurs.
# Sur Replit, utiliser plutôt l'onglet "Secrets".

# --- Base de données (fournie automatiquement par Replit) ---
# DATABASE_URL=postgres://user:pass@host:5432/db

# --- Sessions ---
# Clé de signature des cookies de session (32+ caractères aléatoires).
# Sur Replit, déjà fournie dans les secrets.
# SESSION_SECRET=

# --- Sécurité (BLOC 1) ---
# Mot de passe initial du compte admin créé au premier démarrage.
# Si non défini, un mot de passe aléatoire est généré et affiché dans les logs.
# Ignoré si la base contient déjà des utilisateurs.
INITIAL_ADMIN_PASSWORD=

# --- Données de démonstration (BLOC 4) ---
# Si "false", le seed n'insère QUE l'admin et les paramètres : pas de
# financements, chantier Mbiedou, bande 1 historique, dépenses démo.
# Mettre "false" pour une nouvelle installation client.
SEED_DEMO_DATA=true

# --- IA Gemini (BLOC 1 — modèle paramétrable) ---
# Clé API Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=
# Modèle utilisé pour OCR fiche / extraction texte (défaut: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Modèle utilisé pour génération d'images (défaut: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
