# ============================================
# CONFIGURATION FERME MBIEDOU
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# Base de données PostgreSQL (obligatoire)
DATABASE_URL=postgresql://user:password@host:5432/ferme_mbiedou

# Secret sessions (obligatoire, générer avec : openssl rand -base64 48)
SESSION_SECRET=change-this-to-a-long-random-string

# Environnement
NODE_ENV=production
PORT=3000

# URL du frontend pour CORS (obligatoire en prod)
# Sur Render : https://ferme-mbiedou.onrender.com
# Plusieurs origines : séparer par des virgules
FRONTEND_URL=https://your-app.onrender.com

# URL du backend en développement local (utilisée par le proxy Vite)
# Vide en production : Express sert lui-même le frontend
VITE_API_URL=http://localhost:3000

# Google Gemini pour l'OCR des fiches (optionnel mais recommandé)
# Obtenir une clé sur https://aistudio.google.com/apikey (gratuit)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Mot de passe admin initial (laisser vide = généré automatiquement au 1er démarrage,
# affiché dans les logs serveur)
INITIAL_ADMIN_PASSWORD=

# Données de démo au démarrage (false en production)
SEED_DEMO_DATA=false
