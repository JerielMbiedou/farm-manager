# ===========================================================================
# Ferme Mbiedou — Variables d'environnement
# ===========================================================================
# Copier ce fichier vers .env et remplir les valeurs réelles.
# Ne JAMAIS committer le fichier .env (déjà dans .gitignore).
# ===========================================================================

# --- Base de données PostgreSQL (REQUIS) -----------------------------------
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://ferme:ferme_secret@localhost:5432/ferme_mbiedou

# --- Sécurité sessions (REQUIS) --------------------------------------------
# Générer une chaîne aléatoire d'au moins 32 caractères.
# Exemple: openssl rand -base64 48
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# --- Environnement (REQUIS) ------------------------------------------------
# "production" active : serveur statique du frontend, cookie secure, sameSite=strict
# "development" active : hot reload, CORS permissif
NODE_ENV=production

# --- Port d'écoute du serveur API (REQUIS) ---------------------------------
# Sur Railway/Render le port est imposé par la plateforme — utiliser leur valeur.
PORT=3000

# --- Origines CORS autorisées (OPTIONNEL en dev, REQUIS en prod) -----------
# Liste séparée par virgules. Exemple: https://ferme.example.com,https://www.ferme.example.com
# Si vide en prod : aucune origine externe acceptée (l'app sert son propre frontend).
FRONTEND_URL=https://ferme-mbiedou.example.com

# --- Google Gemini AI (OPTIONNEL — uniquement pour OCR fiches) -------------
# Obtenir une clé sur https://aistudio.google.com/app/apikey
# Sans cette clé, les fonctions de scan automatique de fiches sont désactivées.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Optionnel : proxy Gemini personnalisé ---------------------------------
# Laisser vide pour utiliser l'API Google directe.
# GEMINI_BASE_URL=

# ===========================================================================
# Variables internes Replit (à NE PAS définir hors Replit)
# ===========================================================================
# AI_INTEGRATIONS_GEMINI_API_KEY  → utilisé en fallback si GEMINI_API_KEY absent
# AI_INTEGRATIONS_GEMINI_BASE_URL → utilisé en fallback si GEMINI_BASE_URL absent
# Ces variables sont injectées automatiquement par Replit ; ne pas les copier ici.
